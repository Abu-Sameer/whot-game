# Cache rules for static hosts that read _headers (Netlify, Cloudflare Pages).
# Ignored harmlessly by hosts that don't (Vercel, GitHub Pages).

# The service worker must never be served stale, or players get stuck on an
# old build and never receive the update banner.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# Hashed build assets are immutable — a change produces a new filename.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Icons and sounds are precached by the worker anyway; a day is plenty.
/icons/*
  Cache-Control: public, max-age=86400
/gamesound/*
  Cache-Control: public, max-age=86400
